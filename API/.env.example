# Configure a libpq connection string outside version control. The application
# always enforces sslmode=verify-full; provide sslrootcert with the server CA.
NETSHIELD_DATABASE_URL=host=10.0.0.176 port=5432 dbname=netshield user=netshield_app sslrootcert=/path/to/trusted-server-cert.pem
# Generate a unique secret of at least 32 random bytes and keep it private.
NETSHIELD_JWT_SECRET=
