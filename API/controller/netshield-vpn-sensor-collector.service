[Unit]
Description=NetShield pre-NAT VPN sensor collector
After=network-online.target netshield-vpn-sensor.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/lib/netshield/vpn_sensor_collector.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netshield-vpn-sensor /var/log/netshield-vpn-sensor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
