[Unit]
Description=NetShield pre-NAT WireGuard sensor (ATTACK_RESPONSE/WEB)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/lib/netshield/run_vpn_sensor_ar.sh
Restart=always
RestartSec=10
UMask=0077
MemoryHigh=384M
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/netshield-vpn-sensor-ar

[Install]
WantedBy=multi-user.target
