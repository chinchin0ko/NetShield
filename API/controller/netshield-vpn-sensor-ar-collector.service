[Unit]
Description=NetShield pre-NAT VPN sensor collector (ATTACK_RESPONSE/WEB)
After=network-online.target netshield-vpn-sensor-ar.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/lib/netshield/vpn_sensor_collector.py
Environment=NETSHIELD_SENSOR_EVE=/var/log/netshield-vpn-sensor-ar/eve.json
Environment=NETSHIELD_SENSOR_STATE=/var/lib/netshield-vpn-sensor-ar/cursor.json
Environment=NETSHIELD_SENSOR_SERVICE=netshield-vpn-sensor-ar.service
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netshield-vpn-sensor-ar /var/log/netshield-vpn-sensor-ar
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
