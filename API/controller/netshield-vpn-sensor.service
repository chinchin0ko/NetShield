[Unit]
Description=NetShield pre-NAT WireGuard sensor
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/lib/netshield/run_vpn_sensor.sh
Restart=always
RestartSec=10
UMask=0077
MemoryHigh=384M
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/netshield-vpn-sensor

[Install]
WantedBy=multi-user.target
