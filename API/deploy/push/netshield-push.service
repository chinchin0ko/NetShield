[Unit]
Description=NetShield mobile push delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netshield-api
Group=netshield-api
WorkingDirectory=/opt/netshield-api-dev/API
EnvironmentFile=/etc/netshield-api-dev/push.env
ExecStart=/opt/netshield-api-dev/venv/bin/python -m app.infrastructure.push_worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
