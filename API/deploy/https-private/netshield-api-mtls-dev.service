[Unit]
Description=NetShield API development mTLS listener for trusted proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netshield-api
Group=netshield-api
WorkingDirectory=/opt/netshield-api-dev/API
EnvironmentFile=/etc/netshield-api-dev/app.env
Environment=NETSHIELD_WG_BRIDGE_KEY=/var/lib/netshield-wg-bridge/id_ed25519
Environment=NETSHIELD_WG_BRIDGE_HOST=ubuntu@10.0.0.124
Environment=NETSHIELD_WG_BRIDGE_KNOWN_HOSTS=/var/lib/netshield-wg-bridge/known_hosts
Environment=NETSHIELD_PUBLIC_LIMIT=1
Environment=NETSHIELD_DEV_REGISTRATION=1
ExecStart=/opt/netshield-api-dev/venv/bin/python -m uvicorn app.main:app --host 10.0.0.250 --port 18443 --ssl-keyfile /etc/netshield-private/server.key --ssl-certfile /etc/netshield-private/server.crt --ssl-ca-certs /etc/netshield-private/ca.crt --ssl-cert-reqs 2 --no-proxy-headers --no-server-header
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
