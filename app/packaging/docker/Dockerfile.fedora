# Builder para el paquete .rpm (Fedora/RHEL).
# Compila la app con las librerías de Fedora 43.
FROM fedora:43
RUN dnf install -y \
    clang cmake ninja-build pkg-config gtk3-devel xz-devel \
    git curl unzip zip file which rpm-build redhat-rpm-config \
 && dnf clean all
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} chinchin && useradd -m -u ${UID} -g ${GID} -s /bin/bash chinchin
USER chinchin
WORKDIR /home/chinchin
ENV PATH="/opt/flutter/bin:${PATH}"
